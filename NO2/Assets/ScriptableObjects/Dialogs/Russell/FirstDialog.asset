%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: FirstDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: 
    - conditionKey: anyBadgeUnlocked
      text: 
    - conditionKey: anyBadgeUnlocked
      text: 
    - conditionKey: 
      text: 
    - conditionKey: noneBadgeUnlocked
      text: Veo que no has conseguido ninguna insignia que muestre tu valia
    - conditionKey: noneBadgeUnlocked
      text: Estas de #_suerte_#, tengo el honor de poder otorgar insignias
    - conditionKey: noneBadgeUnlockedAndThenUnlockFirstBadge
      text: "Para ti, ser\xE1 la primera de muchas"
  repetitionTexts:
  - lines:
    - conditionKey: notFiveBadgesUnlocked
      text: Para equiparte una medalla primero debes de ir a una hoguera y descansar
    - conditionKey: notFiveBadgesUnlocked
      text: "Abre el men\xFA de insignias con la \"I\" y ver\xE1s tu banda scout
        junto a tus insignias coleccionadas"
    - conditionKey: notFiveBadgesUnlocked
      text: Simplemente arrastra la insignia que quieras a tu banda para equiparla
    - conditionKey: notFiveBadgesUnlocked
      text: "/Cuidado/ solo tienes 4 huecos, en los que puedes ponerte 4 insignias
        peque\xF1as, dos grandes o una #gigante#"
    - conditionKey: notFiveBadgesUnlocked
      text: "Buscame cuando hayas demostrado tu valia y conseguido m\xE1s insignias"
    - conditionKey: fiveBadgeUnlockedAndNotRusellFirstDialogFinished
      text: SIUUUUUUUUU
    - conditionKey: fiveBadgeUnlockedAndNotRusellFirstDialogFinished
      text: Vas siendo tan capaz como yo
    - conditionKey: fiveBadgeUnlockedAndNotRusellFirstDialogFinished
      text: Enhorabuena
    - conditionKey: fiveBadgeUnlockedAndNotRusellFirstDialogFinishedThenGiveSecondBadge
      text: Toma, te la mereces
    - conditionKey: fiveBadgesUnlockedThenRusellFirstDialogFinished
      text: Yo tambien soy $scout$, debo ponerme las pilas y conseguir mas insignias
    - conditionKey: fiveBadgesUnlockedAndRusellFirstDialogFinished
      text: "Cuando volvamos a vernos tendr\xE9 mas insignias"
    - conditionKey: fiveBadgesUnlockedAndRusellFirstDialogFinished
      text: "Ser\xE9 mejor $scout$"
