%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: DialogoPrimeraConvo
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: Hola, encantado de /verte/
    - conditionKey: 
      text: Soy #rigoberto#, un placer
    - conditionKey: 
      text: Soy un explorador y me dedico a llegar a sitios exoticos
    - conditionKey: 
      text: "*prueba* para ver si las palabras que saltan de una linea a otra se
        ven bien de primeras o si pegan un salto mientras se est\xE1n generando rompiendo
        la inmersion del jugador. Efectivamente, que duro, se podr\xEDa cambiar la
        transparencia de las letras en vez de colocarlas en tiempo real para q eso
        no pase."
  - lines:
    - conditionKey: 
      text: Estoy buscando _flores_ raras
    - conditionKey: 
      text: Te permiten obtener poderes de la naturaleza
    - conditionKey: 
      text: "\xBFMe puedes ense\xF1ar alguna?"
  repetitionTexts:
  - lines:
    - conditionKey: anyFlowerUnlockedAndTheoFirstDialogFinished
      text: '#Buena _suerte_# en tu $viaje$.'
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: OSTIAS TO GUAPO
    - conditionKey: noneFlowerUnlocked
      text: Veo que todavia no has encontrado ninguna flor
    - conditionKey: noneFlowerUnlocked
      text: "Est\xE1 arriba a la izquierda cegato"
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: No habia visto ninguna parecida a esta
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: mmmmmmm
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: Interesante, veo que blah blah cosas cientificas blah blah
    - conditionKey: anyFlowerUnlockedThenTheoFirstDialogFinished
      text: "Muchas gracias, voy a continuar mis viajes. Espero verte por ah\xED"
