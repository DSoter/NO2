%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: DialogoPrimeraConvo
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: Hola, encantado de /verte/
    - conditionKey: 
      text: Soy #rigoberto#, un placer
    - conditionKey: 
      text: Soy un explorador y me dedico a llegar a sitios exoticos
    - conditionKey: 
      text: Me alegro de ver caras nuevas por aqui
  - lines:
    - conditionKey: 
      text: Estoy buscando _flores_ raras
    - conditionKey: 
      text: Te permiten obtener poderes de la naturaleza
    - conditionKey: 
      text: "\xBFMe puedes mostrar alguna?"
  repetitionTexts:
  - lines:
    - conditionKey: anyFlowerUnlockedAndTheoFirstDialogFinished
      text: "Recuerda: en una hoguera abrir el men\xFA (O), confirmar (espacio) y
        elegir la flor que desees. Se equipar\xE1 confirmando o cerrando el men\xFA"
    - conditionKey: anyFlowerUnlockedAndTheoFirstDialogFinished
      text: '#Buena _suerte_# en tu $viaje$.'
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: OSTIAS TO GUAPA
    - conditionKey: noneFlowerUnlocked
      text: Veo que todavia no has encontrado ninguna flor
    - conditionKey: noneFlowerUnlocked
      text: Recuerda que suelen estar en sitios apartados
    - conditionKey: noneFlowerUnlocked
      text: Para agarrarla debes de interactuar con ella con la tecla /E/
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: No habia visto ninguna parecida a esta
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: Para usarla debes de descansar en una hoguera como la que tengo al lado
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: "Despues abre el men\xFA de flores con la \"O\""
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: "Al confirmar con la tecla espacio activar\xE1s el men\xFA y podr\xE1s
        moverte con las flechas o W S"
    - conditionKey: anyFlowerUnlockedAndNotTheoFirstDialogFinished
      text: Cada flor tiene unas cualidades distintas
    - conditionKey: anyFlowerUnlockedThenTheoFirstDialogFinished
      text: "Muchas gracias, voy a continuar mis viajes. Espero verte por ah\xED"
