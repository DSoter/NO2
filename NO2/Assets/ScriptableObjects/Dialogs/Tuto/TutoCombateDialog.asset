  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoCombateDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: "Cuidado, m\xE1s adelante hay uno de tus amiguitos cortandote el paso."
    - conditionKey: 
      text: Es muy peligroso, se puede ver la #=sed de sangre=# en sus ojos.
    - conditionKey: 
      text: "Si te quedas sin vida #=morir\xE1s=# pero no te preocupes, podr\xE1s
        volver a intentarlo hasta que te canses."
    - conditionKey: 
      text: "Para sobrevivir debes estar atento a tu #/resistencia/#, la barra verde
        que tienes en la pantalla. Del &#ox\xEDgeno#& no debes preocuparte, en esta
        cueva hay de sobra."
    - conditionKey: 
      text: "Al =#atacar#= o #_correr_# consumes tu resistencia. Sin ella, no podr\xE1s
        ni atacar ni esquivar."
    - conditionKey: 
      text: "Para correr simplemente debes de mantener la tecla /shift/ pero consumir\xE1s
        resistencia."
  repetitionTexts:
