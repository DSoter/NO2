%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoCombateDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: "Cuidado, m\xE1s adelante hay uno de tus amiguitos cortandote el paso"
    - conditionKey: 
      text: "Deber\xE1s enfrentarte a \xE9l. "
    - conditionKey: 
      text: O ella, estos dias nunca se sabe
  - lines:
    - conditionKey: 
      text: Es muy peligroso, se puede ver en sus ojos la #=sed de sangre=#.
    - conditionKey: 
      text: "Si te quedas sin vida #=morir\xE1s=# pero no te preocupes, podr\xE1s
        volver a intentarlo."
  - lines:
    - conditionKey: 
      text: Para sobrevivir estate atento a tu #/resistencia/#, la barra verde que
        tienes en la pantalla.
    - conditionKey: 
      text: "Al hacer acciones como =#atacar#= o #_correr_# consumen tu resistencia
        hasta que no podr\xE1s realizarlas."
    - conditionKey: 
      text: "Se me ha olvidado completamente explicartelo, para correr simplemente
        mant\xE9n la tecla /shift/, el icono a la izquierda de la tecla /z/, te mover\xE1s
        m\xE1s r\xE1pido pero gastando resistencia."
  repetitionTexts:
  - lines:
    - conditionKey: 
      text: Para sobrevivir estate atento a tu #/resistencia/#, la barra verde que
        tienes en la pantalla.
    - conditionKey: 
      text: "Al hacer acciones como =#atacar#= o #_correr_# consumen tu resistencia
        hasta que no podr\xE1s realizarlas."
    - conditionKey: 
      text: "Recuerda que para correr simplemente debes de mantener la tecla /shift/,
        pero consumir\xE1s resistencia."
