  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoEspadaDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: Veo que ha habido un =#derrumbe#=, te han cortado el paso
    - conditionKey: 
      text: "/\xA1Estamos atrapados!/ \xBFQue vamos a hacer?"
    - conditionKey: 
      text: 'Se me olvidaba, yo simplemente soy un  $cartel$. '
    - conditionKey: 
      text: "\xA1Si no haces nada no podr\xE1s volver a #_casa_#!"
    - conditionKey: 
      text: "_Tranquilo_ tengo una soluci\xF3n, puedes usar tu espada para *#destruir#*
        rocas."
    - conditionKey: 
      text: "Para atacar con tu espada utiliza el clic izquierdo del rat\xF3n."
  repetitionTexts:
