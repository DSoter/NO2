%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoFifthDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: playerNeverDies
      text: Veo que has salido ileso de la pelea.
    - conditionKey: 
      text: _#Bien hecho#_ has conseguido derrotar a uno de ellos.
    - conditionKey: 
      text: Es inevitable, necesitas enfrentarte a ellos para defender tu casa.
    - conditionKey: 
      text: Has hecho el primer paso, ahora solo te falta seguir avanzando.
  - lines:
    - conditionKey: 
      text: '!#&Cachis la mar salada &#, no podemos continuar!'
    - conditionKey: 
      text: Parece una roca... Pero creo que es una poderosa criatura.
    - conditionKey: 
      text: "\xBFPuedes despejar el paso?"
  repetitionTexts:
  - lines:
    - conditionKey: 
      text: "Fijate bien, hay un momento que tiene un borde naranja. Eso significa
        que est\xE1 $vulnerable$."
    - conditionKey: 
      text: "Cuando un enemigo est\xE9 vulnerable podr\xE1s hacer una #/ruptura/#.
        Simplemente deber\xE1s de golpearle para inflingirle da\xF1o extra."
    - conditionKey: 
      text: "Pero con esa espadita no podr\xE1s hacer nada, tienes que usar tu #=mazo=#."
    - conditionKey: 
      text: "Mant\xE9n el #click derecho# para cargar un poderoso ataque, cuanto
        m\xE1s lo cargues m\xE1s da\xF1o har\xE1s. Pero recuerda, cuando empieces
        a parpadear significa que has cargado /a tope/"
    - conditionKey: 
      text: "Cuando sueltes el clic golpear\xE1s en la direcci\xF3n del rat\xF3n."
    - conditionKey: 
      text: "Ten =#cuidado#=, no podr\xE1s moverte mientras cargues, pero si consigues
        golpear a un enemigo en el momento clave, la espera merecer\xE1 la pena."
