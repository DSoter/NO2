  listOfTexts:
  - lines:
    - conditionKey: 
      text: "Puedes realizar un poderoso ataque cargado para hacer m\xE1s da\xF1o
        a los enemigos."
    - conditionKey: 
      text: Manten el click derecho para empezar a cargar
    - conditionKey: 
      text: "Sueltalo para golpear hacia donde apunte el rat\xF3n"
    - conditionKey: 
      text: Tambien sirve para realizar una ruptura en enemigos vulnerables
    - conditionKey: 
      text: Los enemigos estan vulnerables cuando tienen un borde naranja
