  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoHogueraDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: "\xBFHa sido f\xE1cil, no? Sabia que podr\xEDas llegar hasta aqu\xED. "
    - conditionKey: 
      text: Mira, una #=hoguera=#.
    - conditionKey: 
      text: "Permitete #/descansar/#, podr\xE1s recuperar vida y guardar tu progreso."
    - conditionKey: 
      text: Puedes sentarte igual que hablas conmigo, con la tecla /E/, quedandote
        descansando en el fuego hasta volver a pulsarla.
