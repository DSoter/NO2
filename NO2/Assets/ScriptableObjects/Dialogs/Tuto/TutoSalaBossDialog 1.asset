  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoSalaBossDialog 1
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: "Estamos muy cerca de la #salida#, por fin podr\xE1s volver a casa."
    - conditionKey: 
      text: "Igual tus amiguitos se est\xE1n dando un fest\xEDn con tu jard\xEDn."
    - conditionKey: 
      text: "\xA1Date prisa! Espero que no te encuentres con la madre caracol..."
    - conditionKey: 
      text: "#/Prep\xE1rate/#, solo por si acaso."
  repetitionTexts:
  - lines:
    - conditionKey: playerNeverDied
      text: "Has conseguido llegar hasta aqu\xED sin morir, venga que ya queda poco."
    - conditionKey: playerHasDIed
      text: "Aunque esta cueva pueda contigo no impedir\xE1 que llegues a casa."
