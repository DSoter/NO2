%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoSalirDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: _Enhorabuena_, has conseguido salir de esa *#cueva# horrible*
    - conditionKey: playerNeverDied
      text: "Has conseguido que no te derroten esos caracoles, pero esto ha sido
        solo el principio, todav\xEDa debes de llegar a _#casa#_."
    - conditionKey: playerHasDied
      text: "Al final lo conseguiste, has conseguido derrotar al rey caracol. Est\xE1s
        al lado de #_casa_#, si has podido salir podr\xE1s llegar."
    - conditionKey: 
      text: "Pero ten cuidado, tus amiguitos han estado #=comiendo=# la hierba y
        hay zonas sin #&ox\xEDgeno&#, no podr\xE1s estar mucho tiempo en ellas."
    - conditionKey: 
      text: "Si pasas mucho tiempo en una zona sin vegetaci\xF3n #*morir\xE1s*# ya
        que el aire es #=irrespirable=#."
    - conditionKey: 
      text: "Por culpa de #=La Corporaci\xF3n=# el aire est\xE1 contaminado, y de
        no ser por tu _jard\xEDn_ tendr\xEDas que vivir en esta cueva para siempre. "
    - conditionKey: 
      text: "Si nadie hace nada, la fauna se encargar\xE1 de rematar el trabajo...
        Pero ahora puedes _luchar_ y cambiar las cosas."
    - conditionKey: 
      text: "Podr\xE1s conseguir burbujas de ox\xEDgeno al derrotar a cualquier enemigo
        o rompiendo cajas, cr\xE9eme que te haran falta. Mucha suerte en tu viaje
        #_dormil\xF3n_#"
  repetitionTexts:
  - lines:
    - conditionKey: 
      text: _Enhorabuena_, has conseguido salir de esa *#cueva# horrible*
    - conditionKey: playerNeverDied
      text: "Has conseguido que no te derroten esos caracoles, pero esto ha sido
        solo el principio, todav\xEDa debes de llegar a _#casa#_."
    - conditionKey: playerHasDied
      text: "Al final lo conseguiste, has conseguido derrotar al rey caracol. Est\xE1s
        al lado de #_casa_#, si has podido salir podr\xE1s llegar a casa."
    - conditionKey: 
      text: "Pero ten cuidado, tus amiguitos han estado #=comiendo=# la hierba y
        hay zonas sin #&ox\xEDgeno&#, no podr\xE1s estar mucho tiempo en ellas."
    - conditionKey: 
      text: "Si pasas mucho tiempo en una zona sin vegetaci\xF3n #*morir\xE1s*# ya
        que el aire es #=irrespirable=#."
    - conditionKey: 
      text: "Por culpa de #=La Corporaci\xF3n=# el aire est\xE1 contaminado, y de
        no ser por tu _jard\xEDn_ tendr\xEDas que vivir en esta cueva para siempre. "
    - conditionKey: 
      text: "Si nadie hace nada, la fauna se encargar\xE1 de rematar el trabajo...
        Pero ahora puedes _luchar_ y cambiar las cosas."
