--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoVolteretaDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: playerHasDied
      text: TheGame.
    - conditionKey: 
      text: "Cuidado, adem\xE1s de tus amiguitos esta #*cueva*# est\xE1 llena de
        =peligros= como #=trampas=#."
    - conditionKey: 
      text: "Para llegar sano y salvo necesitar\xE1s algo m\xE1s que atacar a cualquier
        cosa que se mueva."
    - conditionKey: 
      text: "Puedes recuperar vida que hayas perdido utilizando las pociones que
        tienes. Puedes beberte todas las que quieras, las recuperar\xE1s al descansar
        en una /#hoguera#/, adem\xE1s saben a fresa. "
    - conditionKey: 
      text: Simplemente pulsa la tecla /F/ para consumir una.
    - conditionKey: 
      text: Tambien puedes esquivar peligros usando la voltereta pulsando el /espacio/.
    - conditionKey: 
      text: "Pero ten cuidado solo ser\xE1s invulnerable durante unos momentos."
  repetitionTexts:
  - lines:
    - conditionKey: 
      text: "Cuidado, adem\xE1s de tus amiguitos esta #*cueva*# est\xE1 llena de
        =peligros= como #=trampas=#."
    - conditionKey: 
      text: "Para llegar sano y salvo necesitar\xE1s algo m\xE1s que atacar a cualquier
        cosa que se mueva."
    - conditionKey: 
      text: "Puedes recuperar vida que hayas perdido utilizando las pociones que
        tienes. Puedes beberte todas las que quieras, las recuperar\xE1s al descansar
        en una /#hoguera#/."
    - conditionKey: 
      text: Simplemente pulsa la tecla /F/ para consumir una.
    - conditionKey: 
      text: Tambien puedes esquivar peligros usando la voltereta pulsando el /espacio/.
    - conditionKey: 
      text: "Pero ten cuidado solo ser\xE1s invulnerable durante unos momentos."
