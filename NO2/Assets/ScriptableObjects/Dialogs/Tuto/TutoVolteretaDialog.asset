  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoVolteretaDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: "Cuidado, adem\xE1s de tus amiguitos esta #*cueva*# est\xE1 llena de
        #=trampas=#."
    - conditionKey: 
      text: "Para llegar sano y salvo necesitar\xE1s algo m\xE1s que atacar a cualquier
        cosa que se mueva."
    - conditionKey: 
      text: Puedes recuperar vida que hayas perdido utilizando las pociones que tienes,
        simplemente pulsa la tecla /F/ para consumir una.
    - conditionKey: 
      text: "Tambien puedes esquivar peligros usando la voltereta pulsando el /espacio/,
        lanzandote en la direcci\xF3n que te est\xE9s moviendo."
    - conditionKey: 
      text: "Pero ten cuidado solo ser\xE1s invulnerable durante unos momentos, adem\xE1s
        de dejarte indefenso momentaneamente tras realizarla."
  repetitionTexts:
