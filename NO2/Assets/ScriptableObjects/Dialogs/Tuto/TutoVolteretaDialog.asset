--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2bb7e4f927c16469fb8e20a9d08185, type: 3}
  m_Name: TutoVolteretaDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  listOfTexts:
  - lines:
    - conditionKey: 
      text: "Cuidado, esta *cueva* est\xE1 llena de #=trampas=#"
    - conditionKey: 
      text: Para llegar a casa necesitas estar vivo
    - conditionKey: 
      text: "Para pasar a trav\xE9s de peligros usa la voltereta, con la tecla Espacio,
        ser\xE1s invulnerable durante unos momentos."
  repetitionTexts:
  - lines:
    - conditionKey: playerNeverDied
      text: "Para pasar a trav\xE9s de peligros usa la voltereta, con la tecla Espacio,
        ser\xE1s invulnerable durante unos momentos."
    - conditionKey: playerHasDied
      text: "Veo que no te han quedado claras mis ense\xF1anzas.."
    - conditionKey: playerHasDied
      text: Recuerda, puedes esquivar peligros haciendo una voltereta, pulsando el
        espacio.
    - conditionKey: playerHasDied
      text: Pero solo seras invulnerable durante unos momentos.
